{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/market-updates",
      "destination": "/market",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://realtorbrando.ca/",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.realtorbrando.ca" }]
    },
    {
      "source": "/:path*",
      "destination": "https://realtorbrando.ca/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.realtorbrando.ca" }]
    }
  ]
}
